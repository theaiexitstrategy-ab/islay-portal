# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Stripe (also set as Supabase edge function secrets)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Vapi AI Voice Assistant
VAPI_API_KEY=

# Meta (Instagram/Facebook) OAuth
# Redirect URI must be registered: https://portal.islaystudiosllc.com/auth/callback/meta
META_APP_ID=
META_APP_SECRET=
NEXT_PUBLIC_META_APP_ID=

# TikTok OAuth
# Redirect URI must be registered: https://portal.islaystudiosllc.com/auth/callback/tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=

# Google OAuth (Analytics)
# Redirect URI must be registered: https://portal.islaystudiosllc.com/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Site URL (for OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://portal.islaystudiosllc.com
